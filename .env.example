# Copy to .env and fill in. Never commit .env.
# Meta Model API (OpenAI SDK, base URL https://api.meta.ai/v1 is built in)
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# SubQ Snap 1.1 (API format UNVERIFIED; if unset or failing, Twin B falls back to Meta)
SUBQ_API_KEY=
SUBQ_BASE_URL=
SUBQ_MODEL=
# Optional second model family for Twin B (used if SubQ is unset or fails)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GitHub (falls back to `gh auth token` if empty)
GITHUB_TOKEN=
DEMO_REPO=lishanishat/doppel-demo
# Fetch agent identities: any random strings, no spaces, different from each other
ORCHESTRATOR_SEED_PHRASE=
TWIN_BUILDER_SEED_PHRASE=
# Stubs: 1 = fixtures (default), 0 = real implementations
DOPPEL_STUBS=1
DOPPEL_STUB_VERDICT=blocked
# Optional knobs: TWIN_TIMEOUT_S=45  MAX_EXAMPLES=300  TWINS_IN_PROCESS=0
