# Copy to .env and fill in. Never commit .env.
# Model APIs (OpenAI-compatible base URLs and model names are UNVERIFIED - check the provider docs)
META_API_KEY=
META_BASE_URL=
META_MODEL=
SUBQ_API_KEY=
SUBQ_BASE_URL=
SUBQ_MODEL=
# GitHub (token with repo scope for the demo repo; used to read PRs and post reviews)
GITHUB_TOKEN=
DEMO_REPO=lishanishat/doppel-demo
# Fetch / Agentverse
AGENTVERSE_API_KEY=
ORCHESTRATOR_SEED=
TWIN_BUILDER_SEED=
# Stubs: 1 = fixtures (default), 0 = real implementations
DOPPEL_STUBS=1
DOPPEL_STUB_VERDICT=blocked
